# Copy this file to .env and fill in the platforms you want to post to.
# A platform with missing values is reported as "Not configured" and skipped.

# Which connectors run, in any order. Leave unset for the eight below.
# Also available, off by default: x, linkedin, facebook_page
# PLATFORMS_ENABLED=bluesky,mastodon,telegram,telegraph,github_gist,devto,huggingface,discord

# Seconds to wait for one platform before reporting it as timed out.
# PLATFORM_TIMEOUT_SECONDS=15
# Seconds to wait when checking that a posted URL opens without login.
# ACCESS_CHECK_TIMEOUT_SECONDS=5

# console (readable) or json (one object per line)
# LOG_FORMAT=console
# LOG_LEVEL=INFO

# Bluesky: Settings > Privacy and security > App passwords
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Mastodon: Preferences > Development > New application (scope: write:statuses)
MASTODON_BASE_URL=
MASTODON_ACCESS_TOKEN=

# Telegram: token from @BotFather; the bot must be an admin of the public channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=

# Telegraph: curl "https://api.telegra.ph/createAccount?short_name=posting&author_name=Your+Name"
TELEGRAPH_ACCESS_TOKEN=

# GitHub: Settings > Developer settings > Fine-grained tokens (Account permissions > Gists: read and write)
GITHUB_GIST_TOKEN=

# DEV: Settings > Extensions > DEV Community API Keys
DEVTO_API_KEY=

# Hugging Face: Settings > Access Tokens (write), plus a public repo you own, e.g. your-name/posting-demo
HUGGINGFACE_TOKEN=
HUGGINGFACE_REPO_ID=
# model, dataset or space
# HUGGINGFACE_REPO_TYPE=model

# Discord: Server Settings > Integrations > Webhooks > Copy Webhook URL
DISCORD_WEBHOOK_URL=

# --- Off by default; add the key to PLATFORMS_ENABLED to use ---

# X: OAuth 2.0 user access token with the tweet.write scope (paid API plan)
X_ACCESS_TOKEN=

# LinkedIn: access token with w_member_social, and the author URN (urn:li:person:... or urn:li:organization:...)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
# LINKEDIN_API_VERSION=202610

# Facebook: Page access token with pages_manage_posts, and the Page ID
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
# FACEBOOK_GRAPH_VERSION=v23.0
